FROM docker.io/library/nginx:1.28-alpine
LABEL org.opencontainers.image.title="NeuroPlan Frontend"

COPY nginx.conf /etc/nginx/nginx.conf
COPY index.html /usr/share/nginx/html/index.html
COPY mvp-app.js /usr/share/nginx/html/mvp-app.js
COPY config.js /usr/share/nginx/html/config.js
COPY assets/neuroplan-brain-icon.png /usr/share/nginx/html/assets/neuroplan-brain-icon.png

# 8080 비특권 포트와 /tmp 쓰기 경로만 사용하므로 OpenShift 임의 UID와 호환됩니다.
RUN chgrp -R 0 /usr/share/nginx/html \
    && chmod -R g=u /usr/share/nginx/html
ENV HOME=/tmp
USER 1001
EXPOSE 8080
ENTRYPOINT ["nginx", "-g", "daemon off;"]

# CI verification: frontend-only deployment

# CI verification: simultaneous deployment
