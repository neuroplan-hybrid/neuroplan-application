pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    environment {
        APP_DIR = 'neuroplan-login-mvp'

        AWS_REGION = 'ap-northeast-2'

        ECR_FRONTEND_REPOSITORY = 'neuroplan-frontend'
        ECR_BACKEND_REPOSITORY  = 'neuroplan-backend'


        GITOPS_REPO_SSH = 'git@github.com:neuroplan-hybrid/neuroplan-gitops.git'
        GITOPS_DIR      = '.gitops'

        KUSTOMIZATION_ROSA =
            '.gitops/overlays/rosa/kustomization.yaml'

        KUSTOMIZATION_ONPREM_DR =
            '.gitops/overlays/onprem-dr/kustomization.yaml'

        ONPREM_KUBECONFIG =
            '/var/lib/jenkins/.kube/config'

        ONPREM_NAMESPACE =
            'application'

        ONPREM_ECR_PULL_SECRET =
            'ecr-pull-secret'
    }

    stages {

        stage('Checkout Application') {
            steps {
                script {
                    def scmVars = checkout scm

                    env.GIT_COMMIT_FULL = scmVars.GIT_COMMIT

                    env.GIT_PREVIOUS_SUCCESSFUL_COMMIT_RESOLVED =
                        scmVars.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?:
                        env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: ''

                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()

                    echo "Commit    : ${env.GIT_COMMIT_FULL}"
                    echo "Image Tag : ${env.IMAGE_TAG}"
                }
            }
        }


        stage('Resolve AWS Context') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'jenkins-ecr-aws',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    script {
                        def accountId = sh(
                            script: '''
                                set -eu

                                account_id="$(
                                    aws sts get-caller-identity \
                                      --query Account \
                                      --output text \
                                    | tr -d '[:space:]'
                                )"

                                case "$account_id" in
                                    ''|*[!0-9]*)
                                        echo "Invalid AWS account ID returned by STS" >&2
                                        exit 1
                                        ;;
                                esac

                                if [ "${#account_id}" -ne 12 ]; then
                                    echo "Invalid AWS account ID length returned by STS" >&2
                                    exit 1
                                fi

                                printf '%s' "$account_id"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.AWS_ACCOUNT_ID = accountId

                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"

                        env.FRONTEND_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_FRONTEND_REPOSITORY}"

                        env.BACKEND_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_BACKEND_REPOSITORY}"

                        echo "AWS Account ID: ${env.AWS_ACCOUNT_ID}"
                        echo "AWS Region   : ${env.AWS_REGION}"
                        echo "ECR Registry : ${env.ECR_REGISTRY}"
                    }
                }
            }
        }


        stage('Detect Changes') {
            steps {
                script {
                    def prev =
                        env.GIT_PREVIOUS_SUCCESSFUL_COMMIT_RESOLVED ?: ''

                    /*
                     * 첫 Jenkins 실행은 ECR에 초기 이미지를
                     * 반드시 생성해야 하므로 둘 다 Build한다.
                     */
                    if (!prev ||
                        sh(
                            script:
                                "git cat-file -e '${prev}^{commit}' 2>/dev/null",
                            returnStatus: true
                        ) != 0) {

                        echo "First build: build both images."

                        env.FRONTEND_CHANGED = 'true'
                        env.BACKEND_CHANGED  = 'true'

                    } else {

                        def changedFiles = sh(
                            script: """
                                git diff --name-only \
                                  '${prev}' \
                                  '${env.GIT_COMMIT_FULL}'
                            """,
                            returnStdout: true
                        ).trim()

                        echo "Changed files:"
                        echo changedFiles ?: "(none)"

                        def files = changedFiles
                            ? changedFiles.split('\n')
                            : []

                        env.FRONTEND_CHANGED = files.any {
                            it.startsWith(
                                'neuroplan-login-mvp/frontend/'
                            )
                        }.toString()

                        env.BACKEND_CHANGED = files.any {
                            it.startsWith(
                                'neuroplan-login-mvp/backend/'
                            )
                        }.toString()
                    }

                    env.FRONTEND_IMAGE_EXISTS = 'false'
                    env.BACKEND_IMAGE_EXISTS  = 'false'

                    echo "Frontend changed : ${env.FRONTEND_CHANGED}"
                    echo "Backend changed  : ${env.BACKEND_CHANGED}"
                }
            }
        }


        stage('Test Backend') {
            when {
                expression {
                    env.BACKEND_CHANGED == 'true'
                }
            }

            steps {
                dir("${APP_DIR}/backend") {
                    sh '''
                        set -eu
                        mvn -B -ntp test
                    '''
                }
            }
        }


        stage('Check Existing ECR Images') {
            when {
                expression {
                    env.FRONTEND_CHANGED == 'true' ||
                    env.BACKEND_CHANGED == 'true'
                }
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'jenkins-ecr-aws',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    script {
                        if (env.FRONTEND_CHANGED == 'true') {
                            def frontendStatus = sh(
                                script: '''
                                    aws ecr describe-images \
                                      --region "$AWS_REGION" \
                                      --repository-name "$ECR_FRONTEND_REPOSITORY" \
                                      --image-ids "imageTag=$IMAGE_TAG" \
                                      >/dev/null 2>&1
                                ''',
                                returnStatus: true
                            )

                            env.FRONTEND_IMAGE_EXISTS =
                                (frontendStatus == 0).toString()
                        }

                        if (env.BACKEND_CHANGED == 'true') {
                            def backendStatus = sh(
                                script: '''
                                    aws ecr describe-images \
                                      --region "$AWS_REGION" \
                                      --repository-name "$ECR_BACKEND_REPOSITORY" \
                                      --image-ids "imageTag=$IMAGE_TAG" \
                                      >/dev/null 2>&1
                                ''',
                                returnStatus: true
                            )

                            env.BACKEND_IMAGE_EXISTS =
                                (backendStatus == 0).toString()
                        }

                        echo "Frontend image exists : ${env.FRONTEND_IMAGE_EXISTS}"
                        echo "Backend image exists  : ${env.BACKEND_IMAGE_EXISTS}"
                    }
                }
            }
        }


        stage('ECR Login') {
            when {
                expression {
                    (
                        env.FRONTEND_CHANGED == 'true' &&
                        env.FRONTEND_IMAGE_EXISTS != 'true'
                    ) || (
                        env.BACKEND_CHANGED == 'true' &&
                        env.BACKEND_IMAGE_EXISTS != 'true'
                    )
                }
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'jenkins-ecr-aws',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        set -eu

                        aws ecr get-login-password \
                          --region "$AWS_REGION" \
                        | docker login \
                          --username AWS \
                          --password-stdin "$ECR_REGISTRY"
                    '''
                }
            }
        }


        stage('Build Frontend') {
            when {
                expression {
                    env.FRONTEND_CHANGED == 'true' &&
                    env.FRONTEND_IMAGE_EXISTS != 'true'
                }
            }

            steps {
                sh '''
                    set -eu

                    docker build \
                      -f "$APP_DIR/frontend/Dockerfile.aws" \
                      -t "$FRONTEND_IMAGE:$IMAGE_TAG" \
                      "$APP_DIR/frontend"
                '''
            }
        }


        stage('Push Frontend') {
            when {
                expression {
                    env.FRONTEND_CHANGED == 'true' &&
                    env.FRONTEND_IMAGE_EXISTS != 'true'
                }
            }

            steps {
                sh '''
                    set -eu
                    docker push "$FRONTEND_IMAGE:$IMAGE_TAG"
                '''
            }
        }


        stage('Build Backend') {
            when {
                expression {
                    env.BACKEND_CHANGED == 'true' &&
                    env.BACKEND_IMAGE_EXISTS != 'true'
                }
            }

            steps {
                sh '''
                    set -eu

                    docker build \
                      -f "$APP_DIR/backend/Dockerfile" \
                      -t "$BACKEND_IMAGE:$IMAGE_TAG" \
                      "$APP_DIR/backend"
                '''
            }
        }


        stage('Push Backend') {
            when {
                expression {
                    env.BACKEND_CHANGED == 'true' &&
                    env.BACKEND_IMAGE_EXISTS != 'true'
                }
            }

            steps {
                sh '''
                    set -eu
                    docker push "$BACKEND_IMAGE:$IMAGE_TAG"
                '''
            }
        }


        stage('Verify ECR Images') {
            when {
                expression {
                    env.FRONTEND_CHANGED == 'true' ||
                    env.BACKEND_CHANGED == 'true'
                }
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'jenkins-ecr-aws',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        set -eu

                        verify_image() {
                            repo="$1"
                            label="$2"

                            digest="$(
                                aws ecr describe-images \
                                  --region "$AWS_REGION" \
                                  --repository-name "$repo" \
                                  --image-ids "imageTag=$IMAGE_TAG" \
                                  --query 'imageDetails[0].imageDigest' \
                                  --output text
                            )"

                            if [ -z "$digest" ] || [ "$digest" = "None" ]; then
                                echo "[FAIL] $label image not found in ECR: $repo:$IMAGE_TAG"
                                exit 1
                            fi

                            echo "[PASS] $label image verified in ECR: $repo:$IMAGE_TAG"
                            echo "       digest=$digest"
                        }

                        if [ "$FRONTEND_CHANGED" = "true" ]; then
                            verify_image "$ECR_FRONTEND_REPOSITORY" "Frontend"
                        fi

                        if [ "$BACKEND_CHANGED" = "true" ]; then
                            verify_image "$ECR_BACKEND_REPOSITORY" "Backend"
                        fi
                    '''
                }
            }
        }


        stage('Refresh On-Prem ECR Pull Secret') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'jenkins-ecr-aws',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        if [ ! -f "$ONPREM_KUBECONFIG" ]; then
                            echo "[FAIL] Jenkins On-Prem kubeconfig not found." >&2
                            exit 1
                        fi

                        # Secret이 없으면 Jenkins가 새로 생성하지 않고 실패
                        /usr/local/bin/kubectl \
                          --kubeconfig "$ONPREM_KUBECONFIG" \
                          -n "$ONPREM_NAMESPACE" \
                          get secret "$ONPREM_ECR_PULL_SECRET" \
                          >/dev/null

                        # AWS ECR 인증 토큰 발급
                        ecr_password="$(
                            aws ecr get-login-password \
                              --region "$AWS_REGION"
                        )"

                        if [ -z "$ecr_password" ]; then
                            echo "[FAIL] Empty ECR authorization password." >&2
                            exit 1
                        fi

                        secret_json="$(mktemp)"
                        patch_json="$(mktemp)"

                        cleanup() {
                            rm -f "$secret_json" "$patch_json"
                            unset ecr_password
                        }

                        trap cleanup EXIT HUP INT TERM

                        # 실제 생성은 하지 않고 로컬에서
                        # dockerconfigjson 데이터만 생성
                        /usr/local/bin/kubectl \
                          create secret docker-registry \
                          "$ONPREM_ECR_PULL_SECRET" \
                          --namespace "$ONPREM_NAMESPACE" \
                          --docker-server="$ECR_REGISTRY" \
                          --docker-username=AWS \
                          --docker-password="$ecr_password" \
                          --dry-run=client \
                          -o json \
                          > "$secret_json"

                        python3 - "$secret_json" "$patch_json" <<'PYJSON'
import json
import sys

source_path = sys.argv[1]
patch_path = sys.argv[2]

with open(source_path, "r", encoding="utf-8") as f:
    source = json.load(f)

dockerconfig = source.get("data", {}).get(".dockerconfigjson")

if not dockerconfig:
    raise SystemExit(
        "[FAIL] .dockerconfigjson was not generated"
    )

patch = {
    "data": {
        ".dockerconfigjson": dockerconfig
    },
    "type": "kubernetes.io/dockerconfigjson"
}

with open(patch_path, "w", encoding="utf-8") as f:
    json.dump(patch, f)
PYJSON

                        # 기존 ecr-pull-secret의 data만 갱신
                        /usr/local/bin/kubectl \
                          --kubeconfig "$ONPREM_KUBECONFIG" \
                          -n "$ONPREM_NAMESPACE" \
                          patch secret "$ONPREM_ECR_PULL_SECRET" \
                          --type=merge \
                          --patch-file="$patch_json" \
                          >/dev/null

                        # 갱신 결과 확인
                        secret_type="$(
                            /usr/local/bin/kubectl \
                              --kubeconfig "$ONPREM_KUBECONFIG" \
                              -n "$ONPREM_NAMESPACE" \
                              get secret "$ONPREM_ECR_PULL_SECRET" \
                              -o 'jsonpath={.type}'
                        )"

                        if [ "$secret_type" != "kubernetes.io/dockerconfigjson" ]; then
                            echo "[FAIL] Invalid ECR pull Secret type: $secret_type" >&2
                            exit 1
                        fi

                        echo "[PASS] On-Prem ECR pull Secret refreshed."
                        echo "       namespace=$ONPREM_NAMESPACE"
                        echo "       secret=$ONPREM_ECR_PULL_SECRET"
                        echo "       registry=$ECR_REGISTRY"
                    '''
                }
            }
        }


        stage('Checkout GitOps') {
            when {
                expression {
                    env.FRONTEND_CHANGED == 'true' ||
                    env.BACKEND_CHANGED == 'true'
                }
            }

            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'neuroplan-gitops-ssh',
                        keyFileVariable: 'GITOPS_REPO_KEY',
                        usernameVariable: 'GITOPS_REPO_USER'
                    )
                ]) {
                    sh '''
                        set -eu

                        rm -rf "$GITOPS_DIR"

                        export GIT_SSH_COMMAND="ssh \
                          -i $GITOPS_REPO_KEY \
                          -o IdentitiesOnly=yes \
                          -o StrictHostKeyChecking=accept-new"

                        git clone \
                          --branch main \
                          "$GITOPS_REPO_SSH" \
                          "$GITOPS_DIR"
                    '''
                }
            }
        }


        stage('Update GitOps Image Tags') {
            when {
                expression {
                    env.FRONTEND_CHANGED == 'true' ||
                    env.BACKEND_CHANGED == 'true'
                }
            }

            steps {
                sh '''
                    set -eu

                    python3 <<'PY'
import os
from pathlib import Path

paths = [
    Path(os.environ["KUSTOMIZATION_ROSA"]),
    Path(os.environ["KUSTOMIZATION_ONPREM_DR"]),
]

tag = os.environ["IMAGE_TAG"]

targets = []

if os.environ["FRONTEND_CHANGED"] == "true":
    targets.append(os.environ["FRONTEND_IMAGE"])

if os.environ["BACKEND_CHANGED"] == "true":
    targets.append(os.environ["BACKEND_IMAGE"])

for path in paths:
    lines = path.read_text().splitlines()

    for image in targets:
        found = False

        for i, line in enumerate(lines):
            if line.strip() == f"newName: {image}":

                for j in range(i + 1, min(i + 4, len(lines))):
                    if lines[j].strip().startswith("newTag:"):
                        indent = lines[j][
                            :len(lines[j]) - len(lines[j].lstrip())
                        ]

                        lines[j] = f'{indent}newTag: "{tag}"'
                        found = True
                        break

                break

        if not found:
            raise SystemExit(
                f"newTag entry not found for image: {image} in {path}"
            )

    path.write_text(chr(10).join(lines) + chr(10))
PY

                    echo "ROSA:"
                    grep -A2 'newName:' \
                      "$KUSTOMIZATION_ROSA"

                    echo
                    echo "On-Prem DR:"
                    grep -A2 'newName:' \
                      "$KUSTOMIZATION_ONPREM_DR"
                '''
            }
        }


        stage('Validate GitOps') {
            when {
                expression {
                    env.FRONTEND_CHANGED == 'true' ||
                    env.BACKEND_CHANGED == 'true'
                }
            }

            steps {
                sh '''
                    set -eu

                    kubectl kustomize \
                      "$GITOPS_DIR/overlays/rosa" \
                      > "$WORKSPACE/.ci-neuroplan-rosa-rendered.yaml"

                    kubectl kustomize \
                      "$GITOPS_DIR/overlays/onprem-dr" \
                      > "$WORKSPACE/.ci-neuroplan-onprem-dr-rendered.yaml"

                    if [ "$FRONTEND_CHANGED" = "true" ]; then
                        grep -q \
                          "image: $FRONTEND_IMAGE:$IMAGE_TAG" \
                          "$WORKSPACE/.ci-neuroplan-rosa-rendered.yaml"

                        grep -q \
                          "image: $FRONTEND_IMAGE:$IMAGE_TAG" \
                          "$WORKSPACE/.ci-neuroplan-onprem-dr-rendered.yaml"
                    fi

                    if [ "$BACKEND_CHANGED" = "true" ]; then
                        grep -q \
                          "image: $BACKEND_IMAGE:$IMAGE_TAG" \
                          "$WORKSPACE/.ci-neuroplan-rosa-rendered.yaml"

                        grep -q \
                          "image: $BACKEND_IMAGE:$IMAGE_TAG" \
                          "$WORKSPACE/.ci-neuroplan-onprem-dr-rendered.yaml"
                    fi

                    echo "[PASS] GitOps manifests validated"
                '''
            }
        }


        stage('Commit GitOps Change') {
            when {
                expression {
                    env.FRONTEND_CHANGED == 'true' ||
                    env.BACKEND_CHANGED == 'true'
                }
            }

            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'neuroplan-gitops-ssh',
                        keyFileVariable: 'GITOPS_REPO_KEY',
                        usernameVariable: 'GITOPS_REPO_USER'
                    )
                ]) {
                    sh '''
                        set -eu

                        cd "$GITOPS_DIR"

                        if git diff --quiet -- \
                          overlays/rosa/kustomization.yaml \
                          overlays/onprem-dr/kustomization.yaml; then
                            echo "No GitOps changes to commit."
                            exit 0
                        fi

                        git config user.name "NeuroPlan Jenkins"
                        git config user.email "jenkins@nplan.local"

                        git add \
                          overlays/rosa/kustomization.yaml \
                          overlays/onprem-dr/kustomization.yaml

                        git commit \
                          -m "ci: deploy image $IMAGE_TAG"

                        export GIT_SSH_COMMAND="ssh \
                          -i $GITOPS_REPO_KEY \
                          -o IdentitiesOnly=yes \
                          -o StrictHostKeyChecking=accept-new"

                        for attempt in 1 2 3; do
                            if git push origin HEAD:main; then
                                exit 0
                            fi

                            if [ "$attempt" -eq 3 ]; then
                                break
                            fi

                            echo "GitOps push failed (attempt ${attempt}/3)."
                            echo "Fetching latest main and rebasing before retry..."

                            git fetch origin main

                            if ! git rebase origin/main; then
                                git rebase --abort || true
                                echo "GitOps rebase conflict requires manual resolution."
                                exit 1
                            fi

                            sleep $((attempt * 2))
                        done

                        echo "GitOps push failed after 3 attempts."
                        exit 1
                    '''
                }
            }
        }
    }


    post {
        success {
            echo "NeuroPlan AWS CI pipeline completed successfully."
        }

        failure {
            echo "NeuroPlan AWS CI pipeline failed."
        }

        always {
            sh '''
                if [ -n "$ECR_REGISTRY" ]; then
                    docker logout "$ECR_REGISTRY" >/dev/null 2>&1 || true
                fi

                rm -rf "$GITOPS_DIR"

                rm -f \
                  "$WORKSPACE/.ci-neuroplan-rosa-rendered.yaml" \
                  "$WORKSPACE/.ci-neuroplan-onprem-dr-rendered.yaml" \
                  || true
            '''
        }
    }
}
